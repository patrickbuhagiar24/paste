#!/usr/bin/env python3
"""Pastex native-messaging host: bridge between the Chrome extension and
~/.config/pastex/*.json (the browser cannot read local files by itself).

Config files (created with templates on first run):
  ~/.config/pastex/pastex-google-drive.json  {"folder_id": ..., "folder_url": ...}
  ~/.config/pastex/service-account.json  Google Cloud JSON key (client_email + private_key)

Protocol: Chrome native messaging (4-byte LE length + JSON) on stdio.
Requests (responses always carry "ok"):
  {"type": "pastex-status"}                          files present? (no secrets)
  {"type": "pastex-read-config"}                     full SA key + drive config
  {"type": "pastex-read-sites"}                      configured site allowlist
  {"type": "pastex-import-config", "name": ..., "data": {...}}  import one validated file
  {"type": "pastex-import-configs", "files": {...}}   validate and import selected files

Usage:
  pastex-native-host [chrome-extension://<id>/]  # serve Chrome on stdio
  pastex-native-host --init-only                 # ensure dir + templates
"""

from __future__ import annotations

import json
import os
import re
import struct
import sys
import tempfile
from pathlib import Path

HOST_NAME = "com.pastex.native"
CONFIG_DIR_NAME = "pastex"
DRIVE_FILE = "pastex-google-drive.json"
SA_FILE = "service-account.json"
SITES_FILE = "pastex-sites.json"

FOLDER_ID_RE = re.compile(r"/folders/([A-Za-z0-9_-]+)")

# Remove only unmodified README files created by older releases; user-edited
# notes and symlinks are left untouched. New installations create no README.
LEGACY_READMES = {
    "Pastex configuration.\n"
    "- google-drive.json: the shared Drive folder (folder_id or folder_url).\n"
    "- service-account.json: the Google Cloud JSON key for Drive sync.\n"
    "Both are managed from the Pastex Settings page; this folder is created\n"
    "automatically on login and on first use.\n",
    "Pastex configuration.\n"
    "- google-drive.json: the shared Drive folder (folder_id or folder_url).\n"
    "- service-account.json: the Google Cloud JSON key for Drive sync.\n"
    "- sites.json: allowed_sites lists allowed HTTP(S) site origins.\n"
    "Edit these files directly. Restart the browser and reload open pages after\n"
    "changing sites.json. Setup instructions: /usr/share/doc/pastex/README.md.gz.\n"
    "The folder is created automatically on login and on extension startup.\n",
}

DRIVE_TEMPLATE = {
    "folder_id": "",
    "folder_url": "",
    "_note": "Paste the shared Drive folder link as folder_url, or just its ID as folder_id.",
}

SA_TEMPLATE = {
    "type": "service_account",
    "client_email": "",
    "private_key": "",
    "_note": "Replace this file with the JSON key downloaded from Google Cloud Console.",
}


def config_dir() -> Path:
    base = os.environ.get("XDG_CONFIG_HOME") or str(Path.home() / ".config")
    return Path(base) / CONFIG_DIR_NAME


def ensure_configured() -> Path:
    """Create ~/.config/pastex with templates; tighten permissions. Idempotent."""
    directory = config_dir()
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    try:
        os.chmod(directory, 0o700)
    except OSError:
        pass
    defaults = {
        DRIVE_FILE: DRIVE_TEMPLATE,
        SA_FILE: SA_TEMPLATE,
        SITES_FILE: {"allowed_sites": []},
    }
    legacy_names = {DRIVE_FILE: "google-drive.json", SITES_FILE: "sites.json"}
    for name, template in defaults.items():
        path = directory / name
        if not os.path.lexists(path):
            old = directory / legacy_names[name] if name in legacy_names else None
            if old is not None and os.path.lexists(old):
                # Preserve exact old contents, including malformed files; do
                # not hide configuration errors by replacing them with defaults.
                contents = old.read_bytes()
            else:
                contents = (json.dumps(template, indent=2) + "\n").encode("utf-8")
            # Publish a fully written file only if the destination still does
            # not exist. Concurrent hosts and login setup cannot clobber it.
            fd, temporary = tempfile.mkstemp(prefix=".pastex-init-", dir=directory)
            try:
                with os.fdopen(fd, "wb") as stream:
                    stream.write(contents)
                try:
                    os.link(temporary, path)
                except FileExistsError:
                    pass
            finally:
                os.unlink(temporary)
        try:
            if not path.is_symlink():
                os.chmod(path, 0o600)
        except OSError:
            pass
    legacy_readme = directory / "README.txt"
    try:
        if (not legacy_readme.is_symlink() and legacy_readme.is_file()
                and legacy_readme.read_text(encoding="utf-8") in LEGACY_READMES):
            legacy_readme.unlink()
    except (OSError, UnicodeError):
        pass  # Never block configuration if an existing file cannot be read.
    return directory


def _read_json(path: Path):
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
        if not isinstance(data, dict):
            raise ValueError("expected a JSON object")
        return data
    except FileNotFoundError:
        return None
    except (OSError, ValueError) as exc:
        raise ValueError(f"{path.name} is not valid JSON ({exc})")


def resolve_folder_id(data: dict) -> str:
    if not isinstance(data, dict):
        return ""
    folder_id = str(data.get("folder_id") or "").strip()
    if folder_id:
        return folder_id
    url = str(data.get("folder_url") or "")
    match = FOLDER_ID_RE.search(url)
    return match.group(1) if match else ""


def drive_status(directory: Path) -> dict:
    try:
        data = _read_json(directory / DRIVE_FILE)
    except ValueError as exc:
        return {"configured": False, "folderId": "", "folderUrl": "", "error": str(exc)}
    if not data:
        return {"configured": False, "folderId": "", "folderUrl": "", "error": f"{DRIVE_FILE} is missing"}
    folder_id = resolve_folder_id(data)
    return {
        "configured": bool(folder_id),
        "folderId": folder_id,
        "folderUrl": str(data.get("folder_url") or ""),
        "error": "" if folder_id else f"set folder_id or folder_url in {DRIVE_FILE}",
    }


def sa_status(directory: Path) -> dict:
    try:
        data = _read_json(directory / SA_FILE)
    except ValueError as exc:
        return {"configured": False, "email": "", "error": str(exc)}
    if not data:
        return {"configured": False, "email": "", "error": f"{SA_FILE} is missing"}
    email = str(data.get("client_email") or "")
    key = str(data.get("private_key") or "")
    if data.get("type") and data.get("type") != "service_account":
        return {"configured": False, "email": email, "error": f"{SA_FILE} is not a service-account key"}
    if not email or not key:
        return {"configured": False, "email": email, "error": f"{SA_FILE} has an empty client_email or private_key"}
    return {"configured": True, "email": email, "error": ""}


def encode_config(name: str, data) -> bytes:
    """Validate and encode one explicitly named configuration."""
    if name not in (DRIVE_FILE, SA_FILE, SITES_FILE) or not isinstance(data, dict):
        raise ValueError("Unsupported configuration file or JSON object")
    if name == DRIVE_FILE and not resolve_folder_id(data):
        raise ValueError(f"{DRIVE_FILE} needs folder_id or a Drive folder_url")
    if name == SA_FILE:
        key = data.get("private_key")
        if (data.get("type") != "service_account" or not isinstance(data.get("client_email"), str)
                or not data["client_email"].strip() or not isinstance(key, str)
                or "-----BEGIN PRIVATE KEY-----" not in key or "-----END PRIVATE KEY-----" not in key):
            raise ValueError("service-account.json needs a service account email and private key")
    if name == SITES_FILE:
        sites = data.get("allowed_sites")
        if not isinstance(sites, list) or len(sites) > 500:
            raise ValueError("allowed_sites must be an array of at most 500 origins")
        for site in sites:
            match = re.fullmatch(r"(https?)://(?:\*\.)?([a-z0-9-]+(?:\.[a-z0-9-]+)*)/?", site.strip().lower()) if isinstance(site, str) else None
            if not match or len(match[2]) > 253 or any(len(label) > 63 or label.startswith('-') or label.endswith('-') for label in match[2].split('.')):
                raise ValueError(f"{SITES_FILE} contains an invalid site origin")
    encoded = json.dumps(data, indent=2, ensure_ascii=True).encode("utf-8") + b"\n"
    if len(encoded) > 256 * 1024:
        raise ValueError("Configuration file is too large (maximum 256 KB)")
    return encoded


def write_config(directory: Path, name: str, encoded: bytes) -> None:
    # A fixed allowlist of names avoids path traversal; os.replace does not
    # follow an existing destination symlink and readers never see partial JSON.
    fd, temporary = tempfile.mkstemp(prefix=".pastex-import-", dir=directory)
    try:
        with os.fdopen(fd, "wb") as stream:
            stream.write(encoded)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, directory / name)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def handle(message: dict, directory: Path) -> dict:
    kind = message.get("type") if isinstance(message, dict) else None
    if kind == "pastex-status":
        return {
            "ok": True,
            "configDir": str(directory),
            "drive": drive_status(directory),
            "serviceAccount": sa_status(directory),
        }
    if kind == "pastex-import-config":
        name = message.get("name")
        encoded = encode_config(name, message.get("data"))
        write_config(directory, name, encoded)
        return {"ok": True}
    if kind == "pastex-import-configs":
        files = message.get("files")
        if not isinstance(files, dict) or not files or len(files) > 3:
            raise ValueError("Select one or more supported configuration files")
        # Validate every file before making any changes. Each replacement is
        # atomic; report partial completion if a later filesystem write fails.
        encoded_files = {name: encode_config(name, data) for name, data in files.items()}
        imported = []
        for name, encoded in encoded_files.items():
            try:
                write_config(directory, name, encoded)
            except OSError as exc:
                return {"ok": True, "imported": imported, "error": f"{name}: {exc}"}
            imported.append(name)
        return {"ok": True, "imported": imported, "error": ""}
    if kind == "pastex-read-sites":
        try:
            data = _read_json(directory / SITES_FILE)
            sites = data.get("allowed_sites") if data else None
            if not isinstance(sites, list) or not all(isinstance(site, str) for site in sites):
                raise ValueError("allowed_sites must be an array of site origins")
            return {"ok": True, "allowedSites": sites}
        except ValueError as exc:
            return {"ok": False, "error": f"{SITES_FILE}: {exc}"}
    if kind == "pastex-read-config":
        drive = drive_status(directory)
        sa = sa_status(directory)
        # Each file is independent: a key is needed to verify a folder even
        # before the folder file is configured, and vice versa.
        data = _read_json(directory / SA_FILE) if sa["configured"] else None
        return {
            "ok": True,
            "configDir": str(directory),
            "driveError": drive["error"],
            "serviceAccountError": sa["error"],
            "drive": {"folderId": drive["folderId"], "folderUrl": drive["folderUrl"]} if drive["configured"] else None,
            "serviceAccount": {
                "client_email": data["client_email"],
                "private_key": data["private_key"],
            } if data else None,
        }
    return {"ok": False, "error": f"unknown request type: {kind!r}"}


def _read_exact(stream, count: int) -> bytes:
    data = b""
    while len(data) < count:
        chunk = stream.read(count - len(data))
        if not chunk:
            break
        data += chunk
    return data


def serve() -> int:
    directory = ensure_configured()
    stdin = sys.stdin.buffer
    stdout = sys.stdout.buffer
    while True:
        header = _read_exact(stdin, 4)
        if len(header) < 4:
            return 0  # EOF: Chrome went away
        (length,) = struct.unpack("<I", header)
        if length > 64 * 1024 * 1024:
            return 1
        body = _read_exact(stdin, length)
        if len(body) < length:
            return 0
        try:
            message = json.loads(body.decode("utf-8"))
        except ValueError:
            message = None
        if not isinstance(message, dict):
            response = {"ok": False, "error": "request must be a JSON object"}
        else:
            try:
                response = handle(message, directory)
            except (OSError, ValueError) as exc:
                response = {"ok": False, "error": str(exc)}
        payload = json.dumps(response).encode("utf-8")
        stdout.write(struct.pack("<I", len(payload)) + payload)
        stdout.flush()


def main(argv: list[str]) -> int:
    if len(argv) == 2 and argv[1] == "--init-only":
        print(ensure_configured())
        return 0
    # Chrome passes the calling extension origin as argv[1]. The native host
    # manifest enforces the allowed origin; this argument is not an option.
    # Some platforms also pass --parent-window=<handle>.
    if len(argv) == 1 or (
        len(argv) in (2, 3)
        and re.fullmatch(r"chrome-extension://[a-p]{32}/", argv[1])
        and (len(argv) == 2 or re.fullmatch(r"--parent-window=\d+", argv[2]))
    ):
        return serve()
    print(f"usage: {Path(argv[0]).name} [--init-only | chrome-extension://<id>/]", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
