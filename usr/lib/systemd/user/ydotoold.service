[Unit]
Description=ydotool daemon (paste otomatis Paste Teks)
Documentation=https://github.com/patrickbuhagiar24/paste
PartOf=graphical-session.target

[Service]
Type=simple
# ydotool >= 1.0 mengirim event lewat daemon ini; socket-nya berada di
# $XDG_RUNTIME_DIR sehingga hanya pengguna pemilik sesi yang bisa memakainya.
ExecStart=/usr/bin/ydotoold
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
