[Unit]
Description=ydotool daemon (Pastex automatic paste)
Documentation=https://github.com/patrickbuhagiar24/paste
PartOf=graphical-session.target

[Service]
Type=simple
# ydotool >= 1.0 sends events through this daemon; its socket is located in
# $XDG_RUNTIME_DIR, making it available only to the session owner.
ExecStart=/usr/bin/ydotoold
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
