#!/bin/sh
# Install the optional Wayland helpers for Pastex automatic paste:
#   * the udev rule that tags /dev/uinput for the active session (uaccess ACL)
#     and grants the 'pastex' group as a fallback;
#   * membership of the calling account in the 'pastex' group;
#   * the per-user ydotoold unit, enabled for that account.
#
# The package ships the rule and the unit as *templates* in /usr/lib/pastex and
# activates nothing, because Linux Mint's default X11 session needs none of it
# (xdotool sends Ctrl+V through XTEST). This script is the only thing that
# touches the system, and it only runs when the user asks for it:
#
#     pkexec /usr/lib/pastex/pastex-uinput-group <username>
#
# Security: accept exactly one existing system username and never execute
# user-provided commands (no eval). It only adds the account to a group whose
# permission is limited to /dev/uinput, so no caller validation is needed.

set -eu

GROUP="pastex"
RULE_TEMPLATE="/usr/lib/pastex/70-pastex-uinput.rules"
RULE="/usr/lib/udev/rules.d/70-pastex-uinput.rules"
UNIT="/usr/lib/systemd/user/ydotoold.service"

fail() {
    echo "pastex: $*" >&2
    exit 1
}

[ "$#" -eq 1 ] || fail "Usage: $0 <username>"

USER_NAME="$1"

case "$USER_NAME" in
    -*) fail "invalid username" ;;
esac
printf '%s' "$USER_NAME" | grep -Eq '^[a-z_][a-z0-9_.-]{0,31}$' \
    || fail "invalid username: $USER_NAME"
[ "$USER_NAME" != "root" ] || fail "root does not need to be added"
id -u "$USER_NAME" >/dev/null 2>&1 || fail "user not found: $USER_NAME"
[ "$(id -u)" -eq 0 ] || fail "must be run as root (through pkexec)"

# System accounts (for example, daemons) must not receive input-device access.
UID_NUM="$(id -u "$USER_NAME")"
[ "$UID_NUM" -ge 1000 ] || [ "$UID_NUM" -eq 0 ] \
    || fail "only regular user accounts (uid >= 1000) are supported"

# ---------- udev rule ----------

if [ -f "$RULE_TEMPLATE" ]; then
    if [ "$(cat "$RULE_TEMPLATE")" != "$(cat "$RULE" 2>/dev/null)" ]; then
        install -D -m 0644 "$RULE_TEMPLATE" "$RULE" \
            || fail "could not install the udev rule"
        echo "Installed the /dev/uinput udev rule."
    fi
elif [ ! -f "$RULE" ]; then
    fail "the udev rule template is missing: reinstall pastex"
fi

if command -v udevadm >/dev/null 2>&1; then
    udevadm control --reload-rules >/dev/null 2>&1 || true
    udevadm trigger --sysname-match=uinput >/dev/null 2>&1 || true
fi

# ---------- group membership ----------

if ! getent group "$GROUP" >/dev/null 2>&1; then
    groupadd --system "$GROUP" || fail "could not create group $GROUP"
fi

if id -nG "$USER_NAME" | tr ' ' '\n' | grep -qx "$GROUP"; then
    echo "Account '$USER_NAME' is already a member of group '$GROUP'."
else
    usermod -aG "$GROUP" "$USER_NAME" \
        || fail "could not add '$USER_NAME' to group '$GROUP'"
    echo "Account '$USER_NAME' was added to group '$GROUP'."
fi

# Apply device permissions immediately without waiting for a reboot.
if [ -e /dev/uinput ]; then
    chgrp "$GROUP" /dev/uinput >/dev/null 2>&1 || true
    chmod 0660 /dev/uinput >/dev/null 2>&1 || true
fi

# ---------- per-user ydotoold unit ----------

USER_HOME="$(getent passwd "$USER_NAME" | cut -d: -f6)"
USER_UID="$(id -u "$USER_NAME")"
USER_RUNTIME="${XDG_RUNTIME_DIR:-/run/user/$USER_UID}"

if [ -f "$UNIT" ] && command -v ydotoold >/dev/null 2>&1; then
    if [ -d "$USER_RUNTIME" ] && command -v runuser >/dev/null 2>&1; then
        runuser -u "$USER_NAME" -- env XDG_RUNTIME_DIR="$USER_RUNTIME" \
            systemctl --user enable --now ydotoold.service >/dev/null 2>&1 \
            || echo "pastex: ydotoold will be started by the app when needed."
    elif [ -n "${USER_HOME:-}" ] && [ -d "$USER_HOME" ]; then
        install -d -o "$USER_NAME" -g "$USER_NAME" -m 755 \
            "$USER_HOME/.config/systemd/user" >/dev/null 2>&1 || true
        ln -sf "$UNIT" "$USER_HOME/.config/systemd/user/ydotoold.service" \
            2>/dev/null || true
        chown -h "$USER_NAME":"$USER_NAME" \
            "$USER_HOME/.config/systemd/user/ydotoold.service" \
            >/dev/null 2>&1 || true
    fi
fi

echo "Done. Log out and back in to activate the new group in your session."
exit 0
