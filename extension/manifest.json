{
  "manifest_version": 3,
  "name": "Pastex",
  "version": "2.8.0",
  "description": "Text snippets stored in Google Drive, with a Side Panel and an in-page launcher.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Pastex",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": ["sidePanel", "scripting", "activeTab", "clipboardWrite", "storage", "offscreen"],
  "host_permissions": ["http://*/*", "https://*/*"]
}
