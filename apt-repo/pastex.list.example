# Example Pastex APT sources; copy to /etc/apt/sources.list.d/pastex.sources
#
# Signed GitHub Pages archive (recommended):
Types: deb
URIs: https://patrickbuhagiar24.github.io/paste/
Suites: stonking
Components: main
Architectures: all
Signed-By: /etc/apt/keyrings/pastex.gpg
#
# Local archive built by scripts/setup-apt-repo.sh: same fields, with
# URIs: file:///path/to/paste/apt-repo/dist/ and no Signed-By unless signed.
#
# Unsigned archive: use packaging/pastex-unsigned.sources (Trusted: yes).
