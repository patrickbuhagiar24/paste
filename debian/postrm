#!/bin/sh
# Pastex post-removal: clean up system configuration when the package is removed.
set -eu

GROUP="pastex"

case "${1:-}" in
    purge|remove)
        if getent group "$GROUP" >/dev/null 2>&1; then
            # Remove the group only when it has no remaining members.
            # Existing members may still be logged in or using the group.
            MEMBERS="$(getent group "$GROUP" | cut -d: -f4)"
            if [ -z "$MEMBERS" ]; then
                groupdel "$GROUP" >/dev/null 2>&1 || true
            else
                echo "pastex: group '$GROUP' was kept (members: $MEMBERS)."
                echo "pastex: remove it manually with: sudo groupdel $GROUP"
            fi
        fi
        ;;
esac

exit 0
