#!/bin/sh
# Pastex post-removal: clean up only the marker owned by this package.
# No groups, accounts, services or browser profiles are touched.
set -eu

NOTE_DIR="/var/lib/pastex"
NOTE_MARKER="$NOTE_DIR/install-note-shown"

case "${1:-}" in
    purge)
        rm -f "$NOTE_MARKER"
        rmdir "$NOTE_DIR" 2>/dev/null || true
        ;;
esac

exit 0
