#!/bin/sh
# postinst Paste Teks — buat paste otomatis langsung berfungsi, tanpa langkah
# manual bagi pengguna yang memasang lewat APT.
#
# Yang disiapkan:
#   1. udev rule dengan TAG+="uaccess"  -> ACL rw /dev/uinput untuk pengguna
#      sesi aktif, berlaku SEGERA (tanpa logout).
#   2. grup cadangan 'paste-teks' + keanggotaan pengguna (untuk kasus ACL
#      tidak tersedia: sesi SSH, container, sistem tanpa logind).
#   3. daemon ydotoold diaktifkan per pengguna agar Ctrl+V bisa dikirim.
#
# Catatan: postinst berjalan sebagai root dan $USER tidak tersedia, jadi akun
# pemanggil ditebak berlapis (SUDO_USER -> PKEXEC_UID -> sesi grafis aktif ->
# akun biasa tunggal). Bila tak yakin, hanya cetak instruksi.
set -eu

GROUP="paste-teks"
RULE="/usr/lib/udev/rules.d/70-paste-teks-uinput.rules"
# Dapat diarahkan lewat env untuk pengujian / sistem tak lazim.
DEV="${PASTE_TEKS_UINPUT_DEV:-/dev/uinput}"

say() { echo "paste-teks: $*"; }

# ---------- deteksi akun ----------

is_real_user() {
    _uid="$(id -u "$1" 2>/dev/null || echo 0)"
    [ "$_uid" -ge 1000 ] && [ "$_uid" -lt 60000 ]
}

detect_users() {
    # Cetak satu atau beberapa akun kandidat (bisa lebih dari satu bila
    # beberapa pengguna sedang login). Tidak pernah mengembalikan root.
    found=""
    for candidate in "${SUDO_USER:-}" "${PKEXEC_UID:-}"; do
        [ -n "$candidate" ] || continue
        case "$candidate" in
            [0-9]*) _u="$(getent passwd "$candidate" 2>/dev/null | cut -d: -f1)" ;;
            *) _u="$candidate" ;;
        esac
        if [ -n "${_u:-}" ] && is_real_user "$_u"; then
            echo "$_u"
            return 0
        fi
    done

    if command -v loginctl >/dev/null 2>&1; then
        found="$(loginctl list-sessions --no-legend 2>/dev/null \
            | awk '{print $3}' | while read -r u; do
                [ -n "$u" ] && is_real_user "$u" && echo "$u"
              done | sort -u)"
        if [ -n "$found" ]; then
            echo "$found"
            return 0
        fi
    fi

    _list="$(awk -F: '$3 >= 1000 && $3 < 60000 {print $1}' /etc/passwd \
        | grep -vx nobody || true)"
    if [ "$(printf '%s\n' "$_list" | grep -c .)" -eq 1 ]; then
        printf '%s\n' "$_list"
        return 0
    fi

    return 1
}

# ---------- izin /dev/uinput ----------

apply_permissions() {
    if [ ! -e "$DEV" ]; then
        say "$DEV belum ada (modul uinput belum dimuat) — izin diterapkan saat boot."
        return 0
    fi
    # 1) ACL uaccess untuk pengguna sesi aktif (berlaku tanpa logout).
    if command -v udevadm >/dev/null 2>&1; then
        udevadm control --reload-rules >/dev/null 2>&1 || true
        udevadm trigger --sysname-match=uinput >/dev/null 2>&1 || true
    fi
    # 2) Cadangan grup: 0660 root:paste-teks.
    chgrp "$GROUP" "$DEV" >/dev/null 2>&1 || true
    chmod 0660 "$DEV" >/dev/null 2>&1 || true
}

# ---------- daemon ydotoold ----------

enable_daemon() {
    _user="$1"
    _home="$(getent passwd "$_user" | cut -d: -f6)"
    if [ -z "${_home:-}" ] || [ ! -d "$_home" ]; then
        say "folder home '$_user' tidak ditemukan — ydotoold dilewati."
        return 0
    fi
    _uid="$(id -u "$_user")"
    _runtime="${PASTE_TEKS_RUNTIME_BASE:-/run/user}/$_uid"

    # Jangan aktifkan sebelum paket ydotool ada (Recommends, mungkin absen).
    if ! command -v ydotoold >/dev/null 2>&1; then
        say "ydotool tidak terpasang — paste otomatis memakai xdotool/cadangan."
        return 0
    fi

    if [ -d "$_runtime" ]; then
        # Sesi sedang aktif: nyalakan & aktifkan sekarang (tanpa menunggu login).
        runuser -u "$_user" -- env XDG_RUNTIME_DIR="$_runtime" \
            systemctl --user enable --now ydotoold.service >/dev/null 2>&1 \
            || say "ydotoold belum bisa dinyalakan untuk '$_user' — coba dari aplikasi."
    else
        # Pengguna belum login: cukup tautkan agar menyala pada login berikutnya.
        install -d -o "$_user" -g "$_user" -m 755 "$_home/.config/systemd/user" \
            >/dev/null 2>&1 || true
        ln -sf /usr/lib/systemd/user/ydotoold.service \
            "$_home/.config/systemd/user/ydotoold.service" 2>/dev/null || true
        chown -h "$_user":"$_user" "$_home/.config/systemd/user/ydotoold.service" \
            >/dev/null 2>&1 || true
    fi
}

enable_shortcut() {
    # Pintasan global Ctrl+Alt+V: gsettings harus dijalankan DI DALAM sesi
    # pengguna (butuh D-Bus & dconf miliknya), bukan sebagai root.
    _user="$1"
    _uid="$(id -u "$_user")"
    _runtime="${PASTE_TEKS_RUNTIME_BASE:-/run/user}/$_uid"
    if [ ! -d "$_runtime" ]; then
        say "pintasan Ctrl+Alt+V akan tersedia setelah '$_user' login."
        return 0
    fi
    if command -v gsettings >/dev/null 2>&1; then
        runuser -u "$_user" -- env XDG_RUNTIME_DIR="$_runtime" \
            DBUS_SESSION_BUS_ADDRESS="unix:path=$_runtime/bus" \
            paste-teks --install-shortcut >/dev/null 2>&1 \
            && say "pintasan global Ctrl+Alt+V dipasang." \
            || say "pintasan global belum dipasang (bisa dari menu ⌨ Pintasan)."
    fi
}

# ---------- aksi ----------

case "${1:-}" in
    configure|abort-upgrade|abort-remove|abort-deconfigure)
        if ! getent group "$GROUP" >/dev/null 2>&1; then
            groupadd --system "$GROUP" 2>/dev/null \
                || say "peringatan: gagal membuat grup $GROUP"
        fi

        if [ -e "$RULE" ]; then
            apply_permissions
        fi

        USERS="$(detect_users || true)"
        if [ -z "${USERS:-}" ]; then
            say "tidak bisa mendeteksi akun pengguna secara otomatis."
            say "Paste otomatis biasanya tetap bekerja lewat ACL sesi."
            say "Bila belum, buka Paste Teks > \"Izin Paste Otomatis\", atau:"
            say "  sudo usermod -aG $GROUP <nama-akun-anda>"
            exit 0
        fi

        NEW_MEMBER=0
        for USER_NAME in $USERS; do
            if id -nG "$USER_NAME" 2>/dev/null | tr ' ' '\n' | grep -qx "$GROUP"; then
                say "akun '$USER_NAME' sudah menjadi anggota grup '$GROUP'."
            else
                if usermod -aG "$GROUP" "$USER_NAME" 2>/dev/null; then
                    say "akun '$USER_NAME' ditambahkan ke grup '$GROUP'."
                    NEW_MEMBER=1
                else
                    say "peringatan: gagal menambahkan '$USER_NAME' ke grup $GROUP."
                fi
            fi
            enable_daemon "$USER_NAME"
            enable_shortcut "$USER_NAME"
        done

        if ! id -nG "$(echo "$USERS" | head -n1)" 2>/dev/null \
                | tr ' ' '\n' | grep -qx "$GROUP" \
           && [ "$NEW_MEMBER" -eq 0 ]; then
            say "peringatan: grup belum aktif untuk akun ini — gunakan tombol"
            say "\"Izin Paste Otomatis\" di aplikasi bila paste otomatis gagal."
        fi

        # Uji nyata: apakah perangkat sekarang bisa ditulis akun tersebut?
        FIRST="$(echo "$USERS" | head -n1)"
        if [ -n "$FIRST" ]; then
            if [ -e "$DEV" ] && runuser -u "$FIRST" -- test -w "$DEV" 2>/dev/null; then
                say "siap: '$FIRST' bisa menulis $DEV — paste otomatis aktif."
            elif [ ! -e "$DEV" ]; then
                say "$DEV tidak ada — akan dibuat saat modul uinput dimuat."
            else
                say "izin $DEV belum berlaku untuk '$FIRST'."
                say "Buka aplikasi lalu klik \"Izin Paste Otomatis\", atau:"
                say "  sudo udevadm control --reload-rules && sudo udevadm trigger --sysname-match=uinput"
            fi
        fi
        ;;

    *)
        :
        ;;
esac

exit 0
