#!/bin/sh
# Pastex post-installation note: the package registers a Chrome extension.
#
# Google Chrome detects the packaged extension on browser startup.
# No per-user configuration files are created by this package.
set -eu

NOTE_DIR="/var/lib/pastex"
NOTE_MARKER="$NOTE_DIR/install-note-shown"

say() { echo "pastex: $*"; }

case "${1:-}" in
    configure)
        # One-time only: apt passes "configure" on every upgrade as well.
        if [ ! -e "$NOTE_MARKER" ]; then
            say "the Pastex extension is registered with Google Chrome."
            say "launch the browser and enable Pastex when it asks."
            say "Use Config in the extension to select a configuration folder."
            say "Setup is described in the README under /usr/share/doc/pastex/."
            install -d -m 0755 "$NOTE_DIR" >/dev/null 2>&1 || true
            : > "$NOTE_MARKER" 2>/dev/null || true
        fi
        ;;
    *)
        :
        ;;
esac

exit 0
