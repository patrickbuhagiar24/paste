#!/bin/sh
# postinst Paste Teks — siapkan akses /dev/uinput untuk paste otomatis.
#
# Tujuan: beri pengguna izin menulis /dev/uinput TANPA memasukkan mereka ke
# grup 'input' (yang setara akses keylogger). Kami membuat grup sistem
# 'paste-teks' dan udev rule yang hanya membuka perangkat uinput.
#
# Catatan: postinst berjalan sebagai root dan $USER tidak tersedia di sini,
# jadi akun pemanggil ditebak berlapis (SUDO_USER -> sesi grafis aktif ->
# akun uid 1000-59999 tunggal). Bila tidak yakin, hanya cetak instruksi.
set -eu

GROUP="paste-teks"
RULE="/usr/lib/udev/rules.d/70-paste-teks-uinput.rules"

# ---------- helper ----------

say() { echo "paste-teks: $*"; }

is_real_user() {
    # uid 1000-59999 = akun pengguna biasa (bukan sistem, bukan nobody).
    _uid="$(id -u "$1" 2>/dev/null || echo 0)"
    [ "$_uid" -ge 1000 ] && [ "$_uid" -lt 60000 ]
}

detect_user() {
    # 1) sudo / pkexec: akun asli pemanggil.
    for candidate in "${SUDO_USER:-}" "${PKEXEC_UID:-}"; do
        [ -n "$candidate" ] || continue
        case "$candidate" in
            [0-9]*) _u="$(getent passwd "$candidate" | cut -d: -f1)" ;;
            *) _u="$candidate" ;;
        esac
        if [ -n "${_u:-}" ] && is_real_user "$_u"; then
            echo "$_u"
            return 0
        fi
    done

    # 2) Sesi grafis/logind yang sedang aktif (paling andal untuk GUI install).
    if command -v loginctl >/dev/null 2>&1; then
        _u="$(loginctl list-sessions --no-legend 2>/dev/null \
            | awk '{print $3}' | while read -r u; do
                [ -n "$u" ] && is_real_user "$u" && echo "$u" && break
              done | head -n1)"
        if [ -n "${_u:-}" ]; then
            echo "$_u"
            return 0
        fi
    fi

    # 3) Akun biasa tunggal di sistem.
    _list="$(awk -F: '$3 >= 1000 && $3 < 60000 {print $1}' /etc/passwd \
        | grep -vx nobody || true)"
    if [ "$(printf '%s\n' "$_list" | grep -c .)" -eq 1 ]; then
        printf '%s\n' "$_list"
        return 0
    fi

    return 1
}

apply_permissions() {
    if [ -e /dev/uinput ] && command -v udevadm >/dev/null 2>&1; then
        udevadm control --reload-rules >/dev/null 2>&1 || true
        udevadm trigger --sysname-match=uinput >/dev/null 2>&1 || true
        chgrp "$GROUP" /dev/uinput >/dev/null 2>&1 || true
        chmod 0660 /dev/uinput >/dev/null 2>&1 || true
    fi
}

# ---------- aksi ----------

case "${1:-}" in
    configure|abort-upgrade|abort-remove|abort-deconfigure)
        if ! getent group "$GROUP" >/dev/null 2>&1; then
            groupadd --system "$GROUP" 2>/dev/null \
                || say "peringatan: gagal membuat grup $GROUP"
        fi

        if [ -e "$RULE" ]; then
            apply_permissions
        fi

        USER_NAME="$(detect_user || true)"
        if [ -z "${USER_NAME:-}" ]; then
            say "tidak bisa mendeteksi akun pengguna secara otomatis."
            say "Untuk mengaktifkan paste otomatis, jalankan:"
            say "  sudo usermod -aG $GROUP <nama-akun-anda>"
            say "lalu logout & login ulang. Atau buka Paste Teks > Pengaturan"
            say "> \"Aktifkan paste otomatis\"."
            exit 0
        fi

        if id -nG "$USER_NAME" 2>/dev/null | tr ' ' '\n' | grep -qx "$GROUP"; then
            say "akun '$USER_NAME' sudah menjadi anggota grup '$GROUP'."
        else
            if usermod -aG "$GROUP" "$USER_NAME" 2>/dev/null; then
                say "akun '$USER_NAME' ditambahkan ke grup '$GROUP'."
                NEED_RELOGIN=1
            else
                say "peringatan: gagal menambahkan '$USER_NAME' ke grup $GROUP."
                say "jalankan manual: sudo usermod -aG $GROUP $USER_NAME"
            fi
        fi

        if [ "${NEED_RELOGIN:-0}" -eq 1 ]; then
            echo
            say "PENTING: logout lalu login ulang (atau reboot) agar paste"
            say "otomatis (Ctrl+V) berfungsi. Sampai saat itu tombol Paste"
            say "Otomatis hanya akan menyalin teks ke clipboard."
            echo
        fi
        ;;

    *)
        :
        ;;
esac

exit 0
