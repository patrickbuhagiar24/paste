#!/bin/sh
# Pastex post-installation note: the package registers a Chrome extension.
#
# No daemons, groups, or system services are used. Chrome and Chromium pick
# up /usr/share/<browser>/extensions/*.json on launch and offer to enable
# the extension with one click. The per-user config folder ~/.config/pastex/
# is created automatically on login (and on first use); a .deb cannot create
# per-user files at install time.
set -eu

NOTE_DIR="/var/lib/pastex"
NOTE_MARKER="$NOTE_DIR/install-note-shown"

say() { echo "pastex: $*"; }

case "${1:-}" in
    configure)
        # One-time only: apt passes "configure" on every upgrade as well.
        if [ ! -e "$NOTE_MARKER" ]; then
            say "the Pastex extension is registered with Chrome and Chromium."
            say "launch the browser and enable Pastex when it asks."
            say "~/.config/pastex/ is created on login; setup (Drive sync"
            say "keys) is described in the README under /usr/share/doc/pastex/."
            install -d -m 0755 "$NOTE_DIR" >/dev/null 2>&1 || true
            : > "$NOTE_MARKER" 2>/dev/null || true
        fi
        ;;
    *)
        :
        ;;
esac

exit 0
