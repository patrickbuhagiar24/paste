#!/bin/sh
# Pastex post-installation note.
#
# Installing Pastex changes nothing on the system. Linux Mint's default X11
# session needs no setup at all: xclip/xsel own the clipboard and xdotool types
# Ctrl+V through XTEST, so there is no /dev/uinput access, no 'pastex' group and
# no ydotoold daemon.
#
# The Wayland helpers (udev rule, 'pastex' group, per-user ydotool unit) ship as
# templates under /usr/lib/pastex and are only installed by
# `pastex --enable-permissions`, which the user runs in a Wayland session.
set -eu

NOTE_DIR="/var/lib/pastex"
NOTE_MARKER="$NOTE_DIR/install-note-shown"

say() { echo "pastex: $*"; }

case "${1:-}" in
    configure)
        # One-time only: apt passes "configure" on every upgrade as well.
        if [ ! -e "$NOTE_MARKER" ]; then
            say "nothing to configure: the X11 clipboard and xdotool need no permissions."
            say "a Wayland session can add the optional helpers later with:"
            say "  pastex --enable-permissions"
            install -d -m 0755 "$NOTE_DIR" >/dev/null 2>&1 || true
            : > "$NOTE_MARKER" 2>/dev/null || true
        fi
        ;;
    *)
        :
        ;;
esac

exit 0
