#!/usr/bin/make -f
%:
	dh

override_dh_auto_install:
	install -d debian/pastex/usr/bin
	install -m 755 bin/pastex debian/pastex/usr/bin/pastex
	install -d debian/pastex/usr/share/pastex
	cp -r pastex debian/pastex/usr/share/pastex/
	# Since 1.5.0, sample data is not bundled (data/snippets/ was removed).
	install -d debian/pastex/usr/share/applications
	install -m 644 usr/share/applications/pastex.desktop debian/pastex/usr/share/applications/
	install -d debian/pastex/usr/share/icons/hicolor/scalable/apps
	install -m 644 usr/share/icons/hicolor/scalable/apps/pastex.svg debian/pastex/usr/share/icons/hicolor/scalable/apps/
	for size in 64 128 256; do \
	  install -d debian/pastex/usr/share/icons/hicolor/$${size}x$${size}/apps; \
	  install -m 644 usr/share/icons/hicolor/$${size}x$${size}/apps/pastex.png \
	    debian/pastex/usr/share/icons/hicolor/$${size}x$${size}/apps/; \
	done
	install -d debian/pastex/usr/lib/pastex
	install -m 755 usr/lib/pastex/pastex-uinput-group debian/pastex/usr/lib/pastex/
	install -d debian/pastex/usr/lib/udev/rules.d
	install -m 644 usr/lib/udev/rules.d/70-pastex-uinput.rules debian/pastex/usr/lib/udev/rules.d/
	install -d debian/pastex/usr/lib/systemd/user
	install -m 644 usr/lib/systemd/user/ydotoold.service debian/pastex/usr/lib/systemd/user/
	install -d debian/pastex/usr/share/doc/pastex
	install -m 644 README.md debian/pastex/usr/share/doc/pastex/README.md
	install -m 644 LICENSE debian/pastex/usr/share/doc/pastex/copyright
