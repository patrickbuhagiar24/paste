#!/usr/bin/make -f
%:
	dh

override_dh_auto_install:
	install -d debian/paste-teks/usr/bin
	install -m 755 bin/paste-teks debian/paste-teks/usr/bin/paste-teks
	install -d debian/paste-teks/usr/share/paste-teks
	cp -r paste_teks debian/paste-teks/usr/share/paste-teks/
	# Sejak 1.5.0 tidak ada contoh bawaan yang dipasang (data/snippets/ dihapus).
	install -d debian/paste-teks/usr/share/applications
	install -m 644 usr/share/applications/paste-teks.desktop debian/paste-teks/usr/share/applications/
	install -d debian/paste-teks/usr/share/icons/hicolor/scalable/apps
	install -m 644 usr/share/icons/hicolor/scalable/apps/paste-teks.svg debian/paste-teks/usr/share/icons/hicolor/scalable/apps/
	install -d debian/paste-teks/usr/lib/paste-teks
	install -m 755 usr/lib/paste-teks/paste-teks-uinput-group debian/paste-teks/usr/lib/paste-teks/
	install -d debian/paste-teks/usr/lib/udev/rules.d
	install -m 644 usr/lib/udev/rules.d/70-paste-teks-uinput.rules debian/paste-teks/usr/lib/udev/rules.d/
	install -d debian/paste-teks/usr/lib/systemd/user
	install -m 644 usr/lib/systemd/user/ydotoold.service debian/paste-teks/usr/lib/systemd/user/
	install -d debian/paste-teks/usr/share/doc/paste-teks
	install -m 644 README.md debian/paste-teks/usr/share/doc/paste-teks/README.md
	install -m 644 LICENSE debian/paste-teks/usr/share/doc/paste-teks/copyright
